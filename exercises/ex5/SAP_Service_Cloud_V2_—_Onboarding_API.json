{
  "openapi": "3.0.3",
  "info": {
    "title": "SAP Service Cloud V2 — Onboarding API",
    "version": "1.0.0",
    "description": "Subset of SAP Service Cloud V2 APIs for employee onboarding: query employees and create support cases."
  },
  "servers": [
    {
      "url": "https://{hostname}",
      "description": "Example of server url is https://my1234567.crm.cloud.sap",
      "variables": {
        "hostname": {
          "default": ""
        }
      }
    },
    {
      "url": "https://sandbox.api.sap.com/servicecloudv2"
    }
  ],
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "/oauth2/token",
            "scopes": {}
          }
        }
      }
    },
    "schemas": {
      "error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" },
                    "code": { "type": "string" },
                    "target": { "type": "string" }
                  }
                }
              },
              "message": { "type": "string" },
              "target": { "type": "string" }
            }
          }
        }
      },
      "Casecreaterequest": {
        "title": "Case create request",
        "type": "object",
        "properties": {
          "subject": {
            "type": "string",
            "nullable": true,
            "title": "Subject"
          },
          "caseType": {
            "type": "string",
            "nullable": true,
            "title": "Case Type"
          },
          "status": {
            "type": "string",
            "nullable": true,
            "title": "Status Code"
          },
          "priority": {
            "type": "string",
            "nullable": true,
            "title": "Priority Code"
          },
          "escalationStatus": {
            "type": "string",
            "nullable": true,
            "enum": [
              "ESCALATED",
              "NOT_ESCALATED"
            ],
            "title": "Escalation Status"
          },
          "communicationLanguage": {
            "type": "string",
            "nullable": true,
            "title": "Language"
          },
          "employee": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "nullable": true,
                "format": "uuid",
                "title": "Employee ID"
              }
            },
            "title": "Employee"
          },
          "reporter": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "nullable": true,
                "format": "uuid",
                "title": "Reporter ID"
              }
            },
            "title": "Reporter"
          },
          "extensions": {
            "type": "object",
            "properties": {
              "SystemAccessDetails": {
                "type": "string",
                "nullable": true,
                "title": "System Access Details",
                "description": "Comma-separated list of additional systems requiring a support ticket for new hire system access provisioning"
              },
              "TrainingDetails": {
                "type": "string",
                "nullable": true,
                "title": "Training Details",
                "description": "Comma-separated list of role-specific training courses requiring a support ticket for new hire training enrollment"
              }
            },
            "title": "Extensions"
          }
        }
      },
      "Casefile": {
        "title": "Case file",
        "type": "object",
        "properties": {
          "value": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "nullable": true,
                "format": "uuid",
                "title": "ID"
              },
              "displayId": {
                "type": "string",
                "nullable": true,
                "maxLength": 35,
                "title": "Display ID"
              },
              "subject": {
                "type": "string",
                "nullable": true,
                "title": "Subject"
              },
              "caseType": {
                "type": "string",
                "nullable": true,
                "title": "Case Type"
              },
              "caseTypeDescription": {
                "type": "string",
                "nullable": true,
                "title": "Case Type Description"
              },
              "status": {
                "type": "string",
                "nullable": true,
                "title": "Status Code"
              },
              "statusDescription": {
                "type": "string",
                "nullable": true,
                "title": "Status"
              },
              "lifeCycleStatus": {
                "type": "string",
                "nullable": true,
                "enum": [
                  "OPEN",
                  "IN_PROCESS",
                  "COMPLETED",
                  "CLOSED",
                  "DRAFT"
                ],
                "title": "Life Cycle Status"
              },
              "priority": {
                "type": "string",
                "nullable": true,
                "title": "Priority Code"
              },
              "priorityDescription": {
                "type": "string",
                "nullable": true,
                "title": "Priority"
              },
              "escalationStatus": {
                "type": "string",
                "nullable": true,
                "enum": [
                  "ESCALATED",
                  "NOT_ESCALATED"
                ],
                "title": "Escalation Status"
              },
              "employee": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "nullable": true,
                    "format": "uuid",
                    "title": "Employee ID"
                  },
                  "displayId": {
                    "type": "string",
                    "nullable": true,
                    "title": "Employee Business Partner ID"
                  }
                },
                "title": "Employee"
              },
              "reporter": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "nullable": true,
                    "format": "uuid",
                    "title": "Reporter ID"
                  },
                  "displayId": {
                    "type": "string",
                    "nullable": true,
                    "title": "Reporter Business Partner ID"
                  }
                },
                "title": "Reporter"
              },
              "processor": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "nullable": true,
                    "format": "uuid",
                    "title": "Processor ID"
                  },
                  "displayId": {
                    "type": "string",
                    "nullable": true,
                    "title": "Processor Business Partner ID"
                  }
                },
                "title": "Processor"
              },
              "serviceTeam": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "nullable": true,
                    "format": "uuid",
                    "title": "Service Team ID"
                  },
                  "displayId": {
                    "type": "string",
                    "nullable": true,
                    "title": "Service Team Display ID"
                  }
                },
                "title": "Service Team"
              },
              "company": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "nullable": true,
                    "format": "uuid",
                    "title": "Company ID"
                  }
                },
                "title": "Company"
              },
              "categoryLevel1": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "nullable": true,
                    "format": "uuid",
                    "title": "Category Level 1 ID"
                  },
                  "displayId": {
                    "type": "string",
                    "nullable": true,
                    "title": "Category Level 1 Display ID"
                  }
                },
                "title": "Category Level 1"
              },
              "timePoints": {
                "type": "object",
                "properties": {
                  "reportedOn": {
                    "type": "string",
                    "format": "date-time",
                    "nullable": true,
                    "title": "Reported On"
                  }
                },
                "title": "TimePoints"
              },
              "extensions": {
                "type": "object",
                "properties": {
                  "SystemAccessDetails": {
                    "type": "string",
                    "nullable": true,
                    "title": "System Access Details",
                    "description": "Comma-separated list of additional systems requiring a support ticket for new hire system access provisioning"
                  },
                  "TrainingDetails": {
                    "type": "string",
                    "nullable": true,
                    "title": "Training Details",
                    "description": "Comma-separated list of role-specific training courses requiring a support ticket for new hire training enrollment"
                  }
                },
                "title": "Extensions"
              }
            },
            "title": "Case"
          }
        }
      },
      "Employeequeryresponse": {
        "title": "Employee query response",
        "type": "object",
        "properties": {
          "count": {
            "type": "integer",
            "format": "int32"
          },
          "value": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "nullable": true,
                  "format": "uuid",
                  "title": "Technical ID"
                },
                "displayId": {
                  "type": "string",
                  "nullable": true,
                  "title": "Business Partner ID"
                },
                "employeeDisplayId": {
                  "type": "string",
                  "nullable": true,
                  "title": "Employee Display ID"
                },
                "formattedName": {
                  "type": "string",
                  "nullable": true,
                  "title": "Formatted Name"
                },
                "firstName": {
                  "type": "string",
                  "nullable": true,
                  "title": "First Name"
                },
                "lastName": {
                  "type": "string",
                  "nullable": true,
                  "title": "Last Name"
                }
              },
              "title": "Employee"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/sap/c4c/api/v1/employee-service/employees": {
      "get": {
        "operationId": "queryemployeeservice_employee",
        "tags": [
          "Employee"
        ],
        "summary": "Query employees in the system.",
        "description": "Specify query parameters to return desired employee records from the system.",
        "parameters": [
          {
            "name": "$skip",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" },
            "description": "Skip the first n employees."
          },
          {
            "name": "$top",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32" },
            "description": "Show only the first n employees."
          },
          {
            "name": "$filter",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Filter employees by attribute."
          },
          {
            "name": "$select",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Select attributes to be returned."
          },
          {
            "name": "$orderby",
            "in": "query",
            "required": false,
            "schema": { "type": "string" },
            "description": "Order employees by attribute."
          },
          {
            "name": "$count",
            "in": "query",
            "required": false,
            "schema": { "type": "boolean" },
            "description": "Indicates the count of employees to be returned."
          }
        ],
        "responses": {
          "200": {
            "description": "Employees retrieved from the system",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Employeequeryresponse" }
              }
            }
          },
          "400": {
            "description": "Bad Request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/error" }
              }
            }
          },
          "401": { "description": "Unauthorized." },
          "403": { "description": "User is not authorized to query employees in the system." },
          "404": { "description": "Employee not found." },
          "500": {
            "description": "Internal Server Error. Failed to query employees.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/error" }
              }
            }
          }
        }
      }
    },
    "/sap/c4c/api/v1/case-service/cases": {
      "post": {
        "operationId": "createcaseservice_case",
        "tags": [
          "Case"
        ],
        "summary": "Create a new case.",
        "description": "Send case information to the system to create a new case entity.",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/Casecreaterequest" },
              "examples": {
                "one": {
                  "value": {
                    "subject": "New Hire Onboarding — System Access & Training Assignment for John Doe (jdoe1)",
                    "caseType": "ZEST",
                    "employee": { "id": "00163e03-552b-1ee2-8784-ecd231debb1d" },
                    "reporter": { "id": "00163e03-552b-1ee2-8784-ecd231debb1d" },
                    "extensions": {
                      "SystemAccessDetails": "Best Run CRM, Best Run CPQ",
                      "TrainingDetails": "Best Run Sales Methodology, Best Run Product Portfolio Overview"
                    }
                  },
                  "summary": "Create onboarding support case"
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Case created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Casefile" }
              }
            }
          },
          "400": {
            "description": "Bad Request.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/error" }
              }
            }
          },
          "401": { "description": "Unauthorized." },
          "403": { "description": "Forbidden." },
          "500": {
            "description": "Internal Server Error. Failed to create the case.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/error" }
              }
            }
          }
        }
      }
    }
  }
}
